{
  "name": "datto-saas-protection-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Datto SaaS Protection MCP server for Claude — M365/GWS backup status, restores, seat management",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "datto-saas-protection-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:ui": "vite build && node scripts/embed-ui.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:mcpb": "node scripts/pack-mcpb.js",
    "validate:mcpb": "mcpb validate manifest.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsimplyltd/datto-saas-protection-mcp.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "datto",
    "saas-backup",
    "backupify",
    "m365",
    "google-workspace",
    "kaseya",
    "msp"
  ],
  "author": "IT Simply Ltd",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/itsimplyltd/datto-saas-protection-mcp/issues"
  },
  "homepage": "https://github.com/itsimplyltd/datto-saas-protection-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
